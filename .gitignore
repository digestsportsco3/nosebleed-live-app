.env
.env.*
!.env.example
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store
Thumbs.db
data/grades.json
data/snapshots.json

# Contract records: never commit operator PII to this public repo
contracts/private/
contracts/**/*.pdf
# Private working tools: these must reference real names and per-operator
# generators to do their job, so they live beside the generators, not in here.
contracts/**/scrub_templates.py
contracts/**/build_all.py
contracts/**/make_*.py
contracts/**/verify_*.py

# Raw Stathead/Baseball Reference pages are captured only to diagnose a broken
# parse. They are their content, not ours: never commit or republish them.
statdesk/data/browser/**/*.raw.html
statdesk/data/browser/**/verify-failed.html
statdesk/data/browser/**/*-no-table.html
